# -----------------------------------------------------------------------------
# Tool-independent synthesis sanity check -- the checks themselves.
#
# This is not a target build. It is the cheap gate that runs on every push, to
# catch the class of mistakes that simulate fine and then bite in the vendor
# tool: accidental latches, undriven or multiply-driven nets, and a hierarchy
# that does not actually elaborate.
#
# The caller has already read the design (syn/yosys/read_design.ys) and run
# `hierarchy` at one array geometry, so this file must not do either -- it would
# undo the -chparam overrides the caller just applied.
#
# Run:  ./scripts/lint.sh   (or `make lint`), which sweeps every geometry.
# -----------------------------------------------------------------------------

proc
opt -full
fsm
opt -full

# -nomap keeps the accumulator RAM as a $mem cell. A full generic synth would
# flatten those 64 kbit into flip-flops and report a six-figure cell count that
# says nothing about the real design -- on an FPGA it is one block RAM.
memory -nomap
opt -full

# Fails on undriven wires, multiple drivers and combinational loops.
check -assert

# A latch here means an always_comb or a case that does not assign on every
# path. In an array this large it would be easy to miss by eye.
select -assert-none t:$dlatch
select -assert-none t:$dlatchsr
select -assert-none t:$sr
